            { "description": "...", "prompt": "Use Example to ...", "tools_triggered": "tool_name", "expected_behavior": "..." },
            { "description": "...", "prompt": "Use Example to ...", "tools_triggered": "tool_name", "expected_behavior": "..." },
            { "description": "...", "prompt": "Use Example to ...", "tools_triggered": "other_tool", "expected_behavior": "..." },
            { "description": "...", "prompt": "Use Example to ...", "tools_triggered": "other_tool", "expected_behavior": "..." }
          ],
          "negative": [
            { "description": "Why the plugin must NOT be called here. An attachment URL may be mentioned in this text.", "prompt": "Bare prompt, app not named" },
            { "description": "...", "prompt": "..." },
            { "description": "...", "prompt": "..." }
          ]
        },
        "demo_recording_url": "https://www.youtube.com/watch?v=VIDEO_ID",
